{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turms",
  "version": "0.1.0",
  "identifier": "com.gravitalia.turms.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gravitalia Turms",
        "width": 1200,
        "height": 700,
        "decorations": true,
        "transparent": true,
        "fullscreen": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self' connect-src 'self' *.gravitalia.com; media-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
